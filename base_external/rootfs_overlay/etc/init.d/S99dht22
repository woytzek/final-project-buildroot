#!/bin/sh

start() {
  echo "Starting DHT22 device ..."
  insmod /lib/modules/$(uname -r)/updates/dht22.ko.xz
}

stop() {
  echo "Stopping DHT22 device ..."
  rmmod dht22
}

restart() {
  stop
  start
}

case $1 in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart|reload)
    restart
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload}"
    exit 1
esac

exit 0

